# Public hostname or IP address that RustDesk clients will use to reach this server
PUBLIC_HOST=localhost

# Initial administrator account (created on first startup)
ADMIN_USER=admin
ADMIN_PASSWORD=godesk-admin
ADMIN_EMAIL=admin@localhost

# Security & networking policy
REQUIRE_KEY=true
ALWAYS_USE_RELAY=false

# Optional: comma-separated relay servers if different from PUBLIC_HOST
RELAY_SERVERS=

# Optional: LAN detection CIDR and local IP
LOCAL_MASK=
LOCAL_IP=

# Standard RustDesk ports
HTTP_PORT=21114
NAT_PORT=21115
RENDEZVOUS_PORT=21116
RELAY_PORT=21117
RENDEZVOUS_WS_PORT=21118
RELAY_WS_PORT=21119

# Structured logging (log/slog)
LOG_LEVEL=info            # debug, info, warn, error
LOG_FORMAT=text           # text or json (includes trace_id & span_id)

# OpenTelemetry (Traces, Metrics, Logs via OTLP) & Prometheus /metrics
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=godesk-plane
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf   # http/protobuf or grpc
OTEL_EXPORTER_OTLP_INSECURE=true

